# ─── FBM Labor System: environment variables ────────────────────────────────
# Copy this file to `.env` and edit it. NEVER commit `.env` to GitHub.

# PostgreSQL connection string. Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://fbm:fbm_dev_password@localhost:5432/fbm?schema=public"

# Secret used to sign session cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Needed when running behind a reverse proxy or on a real domain.
AUTH_TRUST_HOST="true"

# Used ONLY by `npm run db:seed` to create the manager account (the only user).
# You are forced to change this password at first login.
SEED_MANAGER_USERNAME="manager"
SEED_MANAGER_NAME="Manager"
SEED_MANAGER_PASSWORD="ChangeMe-Manager-123!"
# The one-time login code is emailed here. Use the manager's own Gmail address.
SEED_MANAGER_EMAIL="manager@gmail.com"

# Optional session settings
SESSION_ABSOLUTE_HOURS="8"
SESSION_IDLE_MINUTES="30"

# ─── Email (sends the login code) ───────────────────────────────────────────
# Gmail setup: turn on 2-Step Verification for the SENDING Google account, then create an
# "App password" at https://myaccount.google.com/apppasswords and paste the 16 characters below
# (never your normal Gmail password). The sending account may be the same as the manager's address.
# Leave these empty in development: the code is then printed in the server console instead.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-sending-account@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
MAIL_FROM="FBM Labor <your-sending-account@gmail.com>"

# ─── Cloudflare ─────────────────────────────────────────────────────────────
# Turnstile bot check on the login form (free). Create a widget at https://dash.cloudflare.com > Turnstile.
# Leave empty to disable. NEXT_PUBLIC_ values are baked into the build: rebuild after changing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Set to "true" ONLY when the app is reachable exclusively through Cloudflare (Tunnel or firewall rule).
# Then the real visitor IP is read from Cloudflare's CF-Connecting-IP header.
TRUST_CLOUDFLARE="false"
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Used by: docker compose --profile cloudflare up -d cloudflared
CLOUDFLARE_TUNNEL_TOKEN=""
# Public address of the site when deployed (needed behind Cloudflare / a proxy)
# AUTH_URL="https://fbm.yourdomain.com"
