// FBM Labor & Task-Based Salary Management System
// Prisma 6.x / PostgreSQL 15+
//
// MONEY: Decimal(14,2) PKR. Never convert to JS number; use Prisma.Decimal / decimal.js.
// DATES: work dates are @db.Date (no time, no timezone). The app treats them as
//        'YYYY-MM-DD' strings in Asia/Karachi. Never build them from `new Date()` math.
// RAW SQL: CHECK constraints and partial unique indexes that Prisma cannot express
//          live in prisma/migrations/<ts>_financial_constraints/migration.sql
//          (see docs/01-architecture.md section 5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum WorkerStatus {
  ACTIVE
  INACTIVE
}

enum PricingMethod {
  PER_UNIT
  FIXED_PER_TASK
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum EntryStatus {
  DRAFT
  APPROVED
  VOIDED
}

enum EarningSourceType {
  TASK_ENTRY
  DAILY_ALLOWANCE
}

enum EarningStatus {
  ACTIVE
  REVERSED
}

enum PaymentStatus {
  POSTED
  REVERSED
}

enum AdvanceStatus {
  ACTIVE
  VOIDED
}

// ───────────────────────── Auth & RBAC ─────────────────────────

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  email              String?   @unique
  fullName           String
  passwordHash       String // argon2id
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime  @default(now())
  // Bump to invalidate every existing session for this user (password change,
  // deactivation, role change). Checked server-side on every request.
  sessionVersion     Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles               UserRole[]
  passwordResetTokens PasswordResetToken[]
  loginChallenges     LoginChallenge[]
  auditLogs           AuditLog[]

  rateChanges        TaskRateHistory[]  @relation("RateCreatedBy")
  attendanceRecorded Attendance[]       @relation("AttendanceRecordedBy")
  entriesCreated     DailyWorkEntry[]   @relation("EntryCreatedBy")
  entriesApproved    DailyWorkEntry[]   @relation("EntryApprovedBy")
  entriesVoided      DailyWorkEntry[]   @relation("EntryVoidedBy")
  allowancesCreated  DailyAllowance[]   @relation("AllowanceCreatedBy")
  allowancesApproved DailyAllowance[]   @relation("AllowanceApprovedBy")
  allowancesVoided   DailyAllowance[]   @relation("AllowanceVoidedBy")
  paymentsRecorded   SalaryPayment[]    @relation("PaymentRecordedBy")
  paymentsReversed   SalaryPayment[]    @relation("PaymentReversedBy")
  advancesIssued     Advance[]          @relation("AdvanceIssuedBy")
  advancesVoided     Advance[]          @relation("AdvanceVoidedBy")

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // ADMIN, MANAGER, OPERATOR, VIEWER
  description String?
  isSystem    Boolean          @default(false)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. "settlement:create"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // store only a hash of the emailed/issued token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Second login step: a one-time code emailed to the manager. A session is only ever created from a
// challenge whose code was entered correctly (see src/server/auth/otp.ts).
model LoginChallenge {
  id         String    @id // 256-bit random token, known only to the browser that started the login
  userId     String
  codeHash   String // HMAC of the code; the code itself is never stored
  attempts   Int       @default(0) // wrong guesses so far (cumulative across resends)
  sends      Int       @default(1) // how many emails were sent for this challenge
  lastSentAt DateTime  @default(now())
  expiresAt  DateTime
  verifiedAt DateTime? // set when the correct code is entered
  consumedAt DateTime? // set when the session is created, or when the challenge is invalidated
  ip         String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("login_challenges")
}

// ───────────────────────── Workers ─────────────────────────

model Department {
  id      String   @id @default(cuid())
  name    String   @unique
  workers Worker[]

  @@map("departments")
}

model Worker {
  id           String       @id @default(cuid())
  code         String       @unique // human-facing worker ID, e.g. "W-0001"
  fullName     String
  phone        String?
  departmentId String?
  jobRole      String?
  joiningDate  DateTime     @db.Date
  status       WorkerStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department  Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendance  Attendance[]
  workEntries DailyWorkEntry[]
  allowances  DailyAllowance[]
  earnings    Earning[]
  payments    SalaryPayment[]
  advances    Advance[]

  @@index([status])
  @@index([departmentId])
  @@index([fullName])
  @@map("workers")
}

// ───────────────────────── Tasks & rates ─────────────────────────

model Task {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  pricingMethod PricingMethod // immutable once any work entry exists (enforced in service)
  unitLabel     String? // "unit", "piece", "board"...
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  rates       TaskRateHistory[]
  workEntries DailyWorkEntry[]

  @@map("tasks")
}

// Current rate for a work date = row with the greatest effectiveFrom <= workDate.
// Rows are append-only; never UPDATE a rate, insert a new effective-dated one.
model TaskRateHistory {
  id            String   @id @default(cuid())
  taskId        String
  rate          Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @db.Date
  reason        String?
  createdById   String
  createdAt     DateTime @default(now())

  task      Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  createdBy User             @relation("RateCreatedBy", fields: [createdById], references: [id])
  entries   DailyWorkEntry[]

  @@unique([taskId, effectiveFrom])
  @@map("task_rate_history")
}

// ───────────────────────── Attendance ─────────────────────────

model Attendance {
  id           String           @id @default(cuid())
  workerId     String
  date         DateTime         @db.Date
  status       AttendanceStatus
  note         String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  worker     Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  recordedBy User   @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  @@unique([workerId, date])
  @@index([date])
  @@map("attendance")
}

// ───────────────────────── Daily work ─────────────────────────

// Approved entries are IMMUTABLE. A correction = void the old entry and create a
// replacement (replacesEntryId). Voiding reverses its Earning.
model DailyWorkEntry {
  id              String        @id @default(cuid())
  workerId        String
  workDate        DateTime      @db.Date
  taskId          String
  pricingMethod   PricingMethod // snapshot at time of entry
  quantity        Decimal       @db.Decimal(12, 3)
  rateHistoryId   String? // which rate version was applied (traceability)
  appliedRate     Decimal       @db.Decimal(12, 2) // snapshot - NEVER recomputed
  amount          Decimal       @db.Decimal(14, 2) // quantity * appliedRate, rounded half-up, server-computed
  status          EntryStatus   @default(DRAFT)
  notes           String?
  replacesEntryId String?       @unique
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  voidedById      String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  worker      Worker           @relation(fields: [workerId], references: [id], onDelete: Restrict)
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  rateVersion TaskRateHistory? @relation(fields: [rateHistoryId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("EntryCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?            @relation("EntryApprovedBy", fields: [approvedById], references: [id])
  voidedBy    User?            @relation("EntryVoidedBy", fields: [voidedById], references: [id])
  replaces    DailyWorkEntry?  @relation("EntryReplacement", fields: [replacesEntryId], references: [id])
  replacedBy  DailyWorkEntry?  @relation("EntryReplacement")
  earning     Earning?

  // Partial unique (worker, workDate, task) WHERE status <> 'VOIDED' is added in raw SQL.
  @@index([workerId, workDate])
  @@index([workDate])
  @@index([taskId, workDate])
  @@index([status])
  @@map("daily_work_entries")
}

model DailyAllowance {
  id           String      @id @default(cuid())
  workerId     String
  workDate     DateTime    @db.Date
  amount       Decimal     @db.Decimal(14, 2) // >= 0, default 0
  reason       String?
  status       EntryStatus @default(DRAFT)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  voidedById   String?
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  worker     Worker  @relation(fields: [workerId], references: [id], onDelete: Restrict)
  createdBy  User    @relation("AllowanceCreatedBy", fields: [createdById], references: [id])
  approvedBy User?   @relation("AllowanceApprovedBy", fields: [approvedById], references: [id])
  voidedBy   User?   @relation("AllowanceVoidedBy", fields: [voidedById], references: [id])
  earning    Earning?

  // Partial unique (worker, workDate) WHERE status <> 'VOIDED' is added in raw SQL.
  @@index([workerId, workDate])
  @@index([workDate])
  @@map("daily_allowances")
}

// ───────────────────────── Earnings ledger (source of truth) ─────────────────────────

// One row per approved work entry / approved allowance with amount > 0.
// outstanding = amount - settledAmount (settledAmount = SUM(allocations) + SUM(recoveries),
// maintained inside the same transaction and verified by a reconciliation job).
model Earning {
  id            String            @id @default(cuid())
  workerId      String
  workDate      DateTime          @db.Date
  sourceType    EarningSourceType
  workEntryId   String?           @unique // 1:1 => an entry can generate earnings only once
  allowanceId   String?           @unique
  amount        Decimal           @db.Decimal(14, 2) // original amount, immutable
  settledAmount Decimal           @default(0) @db.Decimal(14, 2)
  status        EarningStatus     @default(ACTIVE)
  reversedAt    DateTime?
  reversalReason String?
  createdAt     DateTime          @default(now())

  worker      Worker            @relation(fields: [workerId], references: [id], onDelete: Restrict)
  workEntry   DailyWorkEntry?   @relation(fields: [workEntryId], references: [id], onDelete: Restrict)
  allowance   DailyAllowance?   @relation(fields: [allowanceId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  recoveries  AdvanceRecovery[]

  // Settlement scan: oldest unpaid first for a worker.
  @@index([workerId, status, workDate, createdAt])
  @@index([workDate])
  @@map("earnings")
}

// ───────────────────────── Salary payments ─────────────────────────

// A settlement = cash paid + (optional) advance recovery, applied to one worker's
// earnings inside [periodStart, periodEnd], oldest first.
model SalaryPayment {
  id                    String        @id @default(cuid())
  receiptNo             String        @unique // human-readable, sequential e.g. "SP-2026-000123"
  idempotencyKey        String        @unique // client-generated; blocks double-submit
  workerId              String
  paymentDate           DateTime      @db.Date // actual cash date (drives cash reports)
  periodStart           DateTime      @db.Date
  periodEnd             DateTime      @db.Date
  cashAmount            Decimal       @db.Decimal(14, 2)
  advanceRecoveryAmount Decimal       @default(0) @db.Decimal(14, 2)
  totalSettled          Decimal       @db.Decimal(14, 2) // cash + recovery
  notes                 String?
  status                PaymentStatus @default(POSTED)
  recordedById          String
  reversedById          String?
  reversedAt            DateTime?
  reversalReason        String?
  createdAt             DateTime      @default(now())

  worker      Worker              @relation(fields: [workerId], references: [id], onDelete: Restrict)
  recordedBy  User                @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  reversedBy  User?               @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  allocations PaymentAllocation[]
  recoveries  AdvanceRecovery[]

  @@index([workerId, paymentDate])
  @@index([paymentDate])
  @@map("salary_payments")
}

// Cash portion applied to a specific earning (permanent history; never deleted).
model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  earningId String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  payment SalaryPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  earning Earning       @relation(fields: [earningId], references: [id], onDelete: Restrict)

  @@unique([paymentId, earningId])
  @@index([earningId])
  @@map("payment_allocations")
}

// ───────────────────────── Advances ─────────────────────────

model Advance {
  id              String        @id @default(cuid())
  workerId        String
  advanceDate     DateTime      @db.Date
  amount          Decimal       @db.Decimal(14, 2)
  recoveredAmount Decimal       @default(0) @db.Decimal(14, 2)
  notes           String?
  status          AdvanceStatus @default(ACTIVE)
  issuedById      String
  voidedById      String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime      @default(now())

  worker     Worker            @relation(fields: [workerId], references: [id], onDelete: Restrict)
  issuedBy   User              @relation("AdvanceIssuedBy", fields: [issuedById], references: [id])
  voidedBy   User?             @relation("AdvanceVoidedBy", fields: [voidedById], references: [id])
  recoveries AdvanceRecovery[]

  @@index([workerId, status, advanceDate])
  @@map("advances")
}

// Links: which advance was recovered, from which earning, in which settlement.
model AdvanceRecovery {
  id        String   @id @default(cuid())
  advanceId String
  earningId String
  paymentId String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  advance Advance       @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  earning Earning       @relation(fields: [earningId], references: [id], onDelete: Restrict)
  payment SalaryPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([advanceId, earningId, paymentId])
  @@index([earningId])
  @@index([paymentId])
  @@map("advance_recoveries")
}

// ───────────────────────── Audit ─────────────────────────

// Append-only. A DB trigger (raw SQL migration) rejects UPDATE and DELETE.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // "settlement.post", "payment.reverse", "rate.change", "auth.login" ...
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  meta       Json? // reason, ip, userAgent, requestId
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
